# Choose one: local (Docker Compose PostgreSQL) or neon (hosted Neon database).
SPRING_PROFILES_ACTIVE=local
DATABASE_NAME=wind_turbine

# Local PostgreSQL example. Docker Compose will supply these same values to the
# application container; use them for an IDE run if PostgreSQL is exposed on 5432.
DATABASE_URL=jdbc:postgresql://localhost:5432/wind_turbine
DATABASE_USERNAME=wind_turbine
DATABASE_PASSWORD=change-me

# Neon example: replace the three DATABASE_* values above with credentials from
# your Neon dashboard. The URL must use the JDBC form and require TLS.
# DATABASE_URL=jdbc:postgresql://<endpoint-host>/<database>?sslmode=require
# DATABASE_USERNAME=<neon-role>
# DATABASE_PASSWORD=<neon-password>
# DB_POOL_MAX_SIZE=5
